# 换行符统一为 LF，避免 Windows / macOS / Linux 互相改文件
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
# 无扩展名的钩子脚本必须 LF，否则 bash 报 \r: command not found
scripts/git-hooks/* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# 二进制素材不走文本处理
*.png binary
*.jpg binary
*.mp4 binary
